<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TypelessSwitch.Core\TypelessSwitch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\typeless-switch.ico" />
    <Resource Include="Assets\typeless-switch-icon.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>TypelessSwitch</AssemblyName>
    <RootNamespace>TypelessSwitch.App</RootNamespace>
    <Version>0.1.2</Version>
    <ApplicationIcon>Assets\typeless-switch.ico</ApplicationIcon>
    <Authors>StatXzy7</Authors>
    <Product>Typeless Switch</Product>
    <Description>A lightweight Windows GUI for switching Typeless accounts and migrating dictionaries.</Description>
    <AllowedReferenceRelatedFileExtensions>.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
