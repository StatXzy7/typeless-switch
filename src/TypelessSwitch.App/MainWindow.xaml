<Window x:Class="TypelessSwitch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typeless Switch" Width="660" Height="760" MinWidth="600" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,20,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="2,0,0,16">
                <TextBlock Text="Typeless Switch" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="切换账号与迁移词典，完成后即可关闭。" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前账号" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        <TextBlock x:Name="AccountEmailText" Text="正在读取…" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock x:Name="AccountStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Style="{StaticResource QuietButton}"
                            VerticalAlignment="Center" Click="RefreshButton_Click" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="切换账号" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="输入邮箱后，在弹出的安全登录页中填写六位验证码。失败时会自动恢复原账号。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SwitchEmailBox" ToolTip="Typeless 登录邮箱" />
                        <Button x:Name="SwitchButton" Grid.Column="1" Content="切换账号" Margin="10,0,0,0" Click="SwitchButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0">
                <StackPanel>
                    <TextBlock Text="词典迁移" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="导出会同时生成 JSON、TXT 和 CSV；导入会自动跳过重复词条。"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13" />
                    <Button x:Name="ExportButton" Content="导出当前词典…" HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButton}" Click="ExportButton_Click" />
                    <Separator Margin="0,10,0,9" Background="{StaticResource BorderBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ImportPathBox" IsReadOnly="True" ToolTip="选择 typeless-dictionary-export.json" />
                        <Button Grid.Column="1" Content="选择文件" Margin="10,0,0,0" Style="{StaticResource QuietButton}"
                                Click="BrowseImportButton_Click" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ImportModeBox" SelectedIndex="0" SelectionChanged="ImportModeBox_SelectionChanged">
                            <ComboBoxItem Content="快速批量（推荐）" Tag="Bulk" />
                            <ComboBoxItem Content="完整元数据" Tag="Full" />
                        </ComboBox>
                        <TextBox x:Name="ConcurrencyBox" Grid.Column="1" Text="12" Margin="10,0,0,0"
                                 ToolTip="并发请求数" IsEnabled="False" />
                        <Button x:Name="ImportButton" Grid.Column="2" Content="开始导入" Margin="10,0,0,0" Click="ImportButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#F0F1F7" CornerRadius="10" Padding="15" Margin="20,0,20,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="准备就绪" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Margin="12,0,0,0"
                            Style="{StaticResource QuietButton}" IsEnabled="False" Click="CancelButton_Click" />
                </Grid>
                <ProgressBar x:Name="OperationProgress" Grid.Row="1" Height="6" Margin="0,12,0,0"
                             Minimum="0" Maximum="100" Value="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
